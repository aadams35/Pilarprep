# Local server route. No API key is required for the Cognito/IAM demo path.
PILLARPREP_BACKEND_URL=
PILLARPREP_BACKEND_REGION=us-east-1
PILLARPREP_BACKEND_AUTH_MODE=iam
PILLARPREP_COGNITO_IDENTITY_POOL_ID=

# Legacy/private server-only fallback. Leave empty for the no-key IAM demo.
PILLARPREP_BACKEND_API_KEY=

# Static browser demo. These are public, non-secret values from the backend stack outputs.
VITE_PILLARPREP_STATIC_DEMO=true
VITE_PILLARPREP_BACKEND_URL=
VITE_PILLARPREP_BACKEND_REGION=us-east-1
VITE_PILLARPREP_COGNITO_IDENTITY_POOL_ID=
